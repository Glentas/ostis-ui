button_action_template =
[*
	action_translate_XML_to_json _-> _action_node;;
	action_initiated _-> _action_node;;
	_action_node _-> rrel_1:: _param;;
*];;
@arc_param = (_action_node _-> _param);;

@string_template_expected_result = [{
  "age": 30,
  "city": "New York",
  "name": "John"
}];;
@string_template_expected_result => nrel_system_identifier: [string_template_expected_result];;


button <- concept_button;;
button => nrel_system_identifier: [button_id];
	   => nrel_action_template: tuple_node;;


tuple_node -> rrel_component_with_input: component_tuple_node;
		   -> button_action_template;
		   -> rrel_input_params: input_param_node;; 

input_param_node -> @arc_param;;


component_tuple_node -> rrel_1: text_field;;

@string_result = [<age>30</age><city>New York</city><name>John</name>];;
@string_result  => nrel_system_identifier: [result];;


text_field <- concept_text_field;
		   => nrel_value: @string_result;;


test_action_node
<- action_generate_template;
-> rrel_1: [button_id];;
