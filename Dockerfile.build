FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Установка зависимостей
RUN apt-get update && apt-get install -y \
    git curl python3-pip python3-venv build-essential cmake ninja-build ccache \
    && rm -rf /var/lib/apt/lists/*

# Установка Conan
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install conan && \
    ln -s /opt/venv/bin/conan /usr/local/bin/conan

WORKDIR /build

# Копируем ТОЛЬКО файлы конфигурации Conan
COPY conanfile.py conanfile.txt* ./
COPY CMakeLists.txt ./

# Настройка Conan (кэшируется) — НЕ ТРОГАЕМ
RUN conan profile detect && \
    conan remote add ostis-ai https://conan.ostis.net/artifactory/api/conan/ostis-ai-library && \
    conan install . -s build_type=Release --build=missing

# 👇 Генерация токена
ARG BUILD_TOKEN
RUN if [ -z "$BUILD_TOKEN" ]; then \
        BUILD_TOKEN="auto-$(date +%s)"; \
    fi && \
    echo "🔥 BUILD_TOKEN: ${BUILD_TOKEN}" > /build/.build_token

# 👇 Копируем исходники
COPY . .

# 👇 ПРИНУДИТЕЛЬНАЯ ПЕРЕКОМПИЛЯЦИЯ (БЕЗ УДАЛЕНИЯ CONAN)
RUN \
    # 1. Удаляем ТОЛЬКО CMake-кэш, сохраняем Conan toolchain!
    rm -rf build/Release/CMakeCache.txt build/Release/CMakeFiles/ && \
    \
    # 2. Отключаем ccache
    export CCACHE_DISABLE=1 && \
    \
    # 3. Создаём "трогатель" — заголовок с текущим временем
    mkdir -p /build/generated && \
    echo '#pragma once' > /build/generated/build_timestamp.h && \
    echo "#define BUILD_TIMESTAMP \"$(date -Iseconds)\"" >> /build/generated/build_timestamp.h && \
    echo "#define BUILD_TOKEN \"${BUILD_TOKEN}\"" >> /build/generated/build_timestamp.h && \
    \
    # 4. "Трогаем" исходники модуля, чтобы CMake увидел изменения
    # (это заставит перекомпилировать именно ваш код, а не зависимости)
    find /build/translators/HTMLTranslatorModule -name '*.cpp' -exec touch {} \; && \
    \
    # 5. Конфигурация CMake (Conan toolchain уже есть!)
    cmake -S . -B build/Release \
        -G "Unix Makefiles" \
        -DCMAKE_TOOLCHAIN_FILE=build/Release/generators/conan_toolchain.cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_DEFAULT_CMP0091=NEW \
        -DAUTO_CCACHE=OFF \
        -DBUILD_TOKEN="${BUILD_TOKEN}" \
        -DGENERATED_INCLUDE_DIR=/build/generated && \
    \
    # 6. Сборка с выводом команд (для отладки)
    cmake --build build/Release -- -j$(nproc) VERBOSE=1 && \
    \
    # 7. Проверка результата
    echo "🔥 Binary timestamp:" && \
    strings build/Release/lib/libostis-ui-html-translator.so | grep -E '^[A-Z][a-z]{2} [A-Z][a-z]{2} [0-9 ]+[0-9:]+' | head -1

CMD ["echo", "Build complete. Extensions are in /build/build/Release/lib/extensions/"]