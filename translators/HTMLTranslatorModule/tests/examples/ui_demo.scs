ui_demo
<- concept_ui_interface;;

menu_bar
<- concept_ui_menu_bar;;
menu_bar
=> nrel_ui_id: [menu_bar1];;

item_general
<- concept_ui_menu_item;;
item_general
=> nrel_ui_id: [item_general];;

item_general_text
<- concept_ui_text_value;
=> nrel_ui_value: [Общие];
-> item_general;;

item_privacy
<- concept_ui_menu_item;;
item_privacy
=> nrel_ui_id: [item_privacy];;

item_privacy_text
<- concept_ui_text_value;
=> nrel_ui_value: [Конфиденциальность];
-> item_privacy;;

ui_demo => nrel_ui_has_component: menu_bar;;
ui_demo => nrel_ui_has_component: item_general;;
ui_demo => nrel_ui_has_component: item_privacy;;

ui_demo => nrel_ui_contains: menu_bar;;
menu_bar => nrel_ui_contains: item_general;;
menu_bar => nrel_ui_contains: item_privacy;;